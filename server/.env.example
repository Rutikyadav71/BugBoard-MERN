PORT=5000
NODE_ENV=development
# Local MongoDB (default install) or paste your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/bugboard
# Generate a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# AI features (optional). The core app works without any of this.
# The key stays on the server: it is never sent to the browser or committed to Git.
# ---------------------------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey, then paste it here.
GEMINI_API_KEY=
# 'gemini' (real model) or 'mock' (offline demo provider, no key or quota needed)
AI_PROVIDER=gemini
# Master switch. Set to false to hide/disable all AI features.
AI_ENABLED=true
# Model names and free-tier availability change. Check https://ai.google.dev/gemini-api/docs/pricing
# and your limits in Google AI Studio, then change these without touching code.
AI_MODEL=gemini-3.5-flash-lite
# Used automatically if the primary model is out of quota or unavailable. Leave empty to disable.
AI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=2048
# App-level guards that protect your shared free-tier quota (per process, reset on restart)
AI_RATE_LIMIT_PER_MINUTE=6
AI_DAILY_LIMIT_PER_USER=40
AI_DAILY_LIMIT_GLOBAL=200
# Mask emails, tokens, keys and similar secrets before text is sent to the model
AI_REDACT_SENSITIVE=true

# Similar-issue detection (runs locally on the server: no AI key and no AI quota needed)
DUPLICATE_MIN_SCORE=0.25
DUPLICATE_MAX_RESULTS=5
DUPLICATE_CANDIDATE_LIMIT=1000
